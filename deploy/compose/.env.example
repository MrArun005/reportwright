# Copy to .env and fill in. Make secrets with:  openssl rand -hex 32

# REQUIRED
PW_ADMIN_EMAIL=you@example.com
PW_ADMIN_PASSWORD=
PW_SESSION_SECRET=
PW_DATA_KEY=
# The address people type. With a domain and --profile https: https://reports.example.com
PW_BASE_URL=http://localhost:3000

# HTTPS (docker compose --profile https up -d): the domain whose DNS points at this server
PW_DOMAIN=

# Optional: scheduled emails
PW_SMTP_URL=
PW_MAIL_FROM=
PW_MAIL_ALLOWED_DOMAINS=

# Optional: where the app listens on the host (default only this machine; Caddy reaches it inside Docker)
# PW_PUBLISH=127.0.0.1:3000
