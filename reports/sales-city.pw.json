{
 "$schema": "pagewright/report@1",
 "name": "City detail",
 "locale": "en-IN",
 "currency": "INR",
 "page": {
  "size": "A4",
  "orientation": "landscape",
  "margins": [
   28,
   28,
   24,
   28
  ]
 },
 "parameters": [
  {
   "name": "city",
   "type": "string",
   "prompt": "City",
   "required": true,
   "default": "Pune",
   "optionsFrom": {
    "dataSet": "All",
    "value": "=Fields.city",
    "label": "=Fields.city & \" (\" & Fields.region & \")\""
   }
  },
  {
   "name": "year",
   "type": "number",
   "prompt": "Year",
   "required": true,
   "default": 2026,
   "options": [
    {
     "value": 2025,
     "label": "2025"
    },
    {
     "value": 2026,
     "label": "2026"
    }
   ]
  },
  {
   "name": "product",
   "type": "string",
   "prompt": "Product",
   "default": "",
   "options": [
    {
     "value": "",
     "label": "All products"
    },
    "Home loans",
    "Personal loans",
    "Gold loans"
   ]
  },
  {
   "name": "month",
   "type": "string",
   "prompt": "Month (or click a column)",
   "default": "",
   "options": [
    {
     "value": "",
     "label": "All months"
    },
    {
     "value": "1",
     "label": "January"
    },
    {
     "value": "2",
     "label": "February"
    },
    {
     "value": "3",
     "label": "March"
    },
    {
     "value": "4",
     "label": "April"
    },
    {
     "value": "5",
     "label": "May"
    },
    {
     "value": "6",
     "label": "June"
    },
    {
     "value": "7",
     "label": "July"
    },
    {
     "value": "8",
     "label": "August"
    },
    {
     "value": "9",
     "label": "September"
    },
    {
     "value": "10",
     "label": "October"
    },
    {
     "value": "11",
     "label": "November"
    },
    {
     "value": "12",
     "label": "December"
    }
   ]
  }
 ],
 "dataSources": [
  {
   "name": "sales",
   "type": "rest",
   "method": "GET",
   "url": "/api/sample/sales/{Parameters.year}"
  },
  {
   "name": "prev",
   "type": "rest",
   "method": "GET",
   "url": "/api/sample/sales/{Parameters.year - 1}"
  }
 ],
 "dataSets": [
  {
   "name": "All",
   "source": "sales",
   "path": "$.rows",
   "fields": [
    {
     "name": "year",
     "type": "number"
    },
    {
     "name": "month",
     "type": "number"
    },
    {
     "name": "region",
     "type": "string"
    },
    {
     "name": "city",
     "type": "string"
    },
    {
     "name": "product",
     "type": "string"
    },
    {
     "name": "loans",
     "type": "number"
    },
    {
     "name": "disbursed",
     "type": "number"
    },
    {
     "name": "npa",
     "type": "number"
    },
    {
     "name": "crore",
     "type": "number",
     "expr": "=Fields.disbursed / 10000000"
    },
    {
     "name": "lakh",
     "type": "number",
     "expr": "=Fields.disbursed / 100000"
    },
    {
     "name": "monthName",
     "type": "string",
     "expr": "=MonthName(Fields.month, True)"
    }
   ]
  },
  {
   "name": "City",
   "source": "sales",
   "path": "$.rows",
   "fields": [
    {
     "name": "year",
     "type": "number"
    },
    {
     "name": "month",
     "type": "number"
    },
    {
     "name": "region",
     "type": "string"
    },
    {
     "name": "city",
     "type": "string"
    },
    {
     "name": "product",
     "type": "string"
    },
    {
     "name": "loans",
     "type": "number"
    },
    {
     "name": "disbursed",
     "type": "number"
    },
    {
     "name": "npa",
     "type": "number"
    },
    {
     "name": "crore",
     "type": "number",
     "expr": "=Fields.disbursed / 10000000"
    },
    {
     "name": "lakh",
     "type": "number",
     "expr": "=Fields.disbursed / 100000"
    },
    {
     "name": "monthName",
     "type": "string",
     "expr": "=MonthName(Fields.month, True)"
