     "type": "number"
    },
    {
     "name": "month",
     "type": "number"
    },
    {
     "name": "region",
     "type": "string"
    },
    {
     "name": "city",
     "type": "string"
    },
    {
     "name": "product",
     "type": "string"
    },
    {
     "name": "loans",
     "type": "number"
    },
    {
     "name": "disbursed",
     "type": "number"
    },
    {
     "name": "npa",
     "type": "number"
    },
    {
     "name": "crore",
     "type": "number",
     "expr": "=Fields.disbursed / 10000000"
    },
    {
     "name": "lakh",
     "type": "number",
     "expr": "=Fields.disbursed / 100000"
    },
    {
     "name": "monthName",
     "type": "string",
     "expr": "=MonthName(Fields.month, True)"
    }
   ],
   "filters": [
    {
     "expr": "=Fields.region",
     "op": "=",
     "value": "=Lookup(Parameters.city, Fields.city, Fields.region, \"All\")"
