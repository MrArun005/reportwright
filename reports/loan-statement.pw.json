{
  "$schema": "pagewright/report@1",
  "name": "Loan statement",
  "locale": "en-IN",
  "currency": "INR",
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margins": [
      36,
      36,
      30,
      36
    ]
  },
  "parameters": [
    {
      "name": "accountId",
      "type": "string",
      "prompt": "Loan account",
      "required": true,
      "default": "LN-2026-004417"
    }
  ],
  "dataSources": [
    {
      "name": "loans",
      "type": "rest",
      "method": "GET",
      "url": "/api/sample/loans/{Parameters.accountId}"
    }
  ],
  "dataSets": [
    {
      "name": "Loan",
      "source": "loans",
      "path": "$.loan",
      "fields": [
        {
          "name": "accountId",
          "type": "string"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "city",
          "type": "string"
        },
        {
          "name": "product",
          "type": "string"
        },
        {
          "name": "principal",
          "type": "number"
        },
        {
          "name": "rate",
          "type": "number"
        },
        {
          "name": "months",
          "type": "number"
        },
        {
          "name": "emi",
          "type": "number"
        },
        {
          "name": "disbursedOn",
          "type": "date"
        },
        {
          "name": "paidCount",
          "type": "number"
        },
        {
          "name": "outstanding",
          "type": "number"
        },
        {
          "name": "nextDue",
          "type": "date"
        }
      ]
    },
    {
      "name": "Payments",
      "source": "loans",
      "path": "$.schedule",
      "fields": [
        {
          "name": "installment",
          "type": "number"
        },
        {
          "name": "dueDate",
          "type": "date"
        },
        {
          "name": "emi",
          "type": "number"
        },
        {
          "name": "principal",
          "type": "number"
        },
        {
          "name": "interest",
          "type": "number"
        },
        {
          "name": "balance",
          "type": "number"
        },
        {
          "name": "status",
          "type": "string"
        }
      ]
    }
  ],
  "styles": {
    "base": {
      "fontFamily": "Inter",
      "fontSize": 9,
      "color": "#1f2937"
    }
  },
