  "dataSets": [
    {
      "name": "Loans",
      "source": "src",
      "path": "$.rows",
      "fields": [
        {
          "name": "id",
          "type": "number"
        },
        {
          "name": "region",
          "type": "string"
        },
        {
          "name": "category",
          "type": "string"
        },
        {
          "name": "amount",
          "type": "number"
        },
        {
          "name": "date",
          "type": "date"
        },
        {
          "name": "active",
          "type": "boolean"
        }
      ],
      "filters": [
        {
          "expr": "=Fields.amount",
          "op": ">=",
          "value": "=Coalesce(Parameters.minAmount, 0)"
        },
        {
          "expr": "=Fields.amount",
          "op": ">=",
          "value": "=Coalesce(Parameters.amountRange[0], 0)"
        },
        {
          "expr": "=Fields.amount",
          "op": "<=",
          "value": "=Coalesce(Parameters.amountRange[1], 1000000)"
        },
        {
          "expr": "=Fields.date",
          "op": ">=",
          "value": "=Coalesce(Parameters.period[0], CDate(\"1900-01-01\"))"
        },
        {
          "expr": "=Fields.date",
          "op": "<=",
          "value": "=Coalesce(Parameters.period[1], CDate(\"2999-12-31\"))"
        },
        {
          "expr": "=Fields.region",
          "op": "in",
          "value": "=Parameters.region"
        },
        {
          "expr": "=Fields.category",
          "op": "in",
          "value": "=Parameters.categories"
        },
        {
          "expr": "=IIf(Parameters.activeOnly, Fields.active, true)",
          "op": "=",
          "value": "=true"
        }
      ]
    }
  ],
