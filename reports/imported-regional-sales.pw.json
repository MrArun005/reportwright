        {
          "name": "name"
        },
        {
          "name": "manager"
        }
      ]
    },
    {
      "name": "Sales",
      "source": "Ledger",
      "path": "$.sales[*]",
      "fields": [
        {
          "name": "region"
        },
        {
          "name": "month"
        },
        {
          "name": "monthNo"
        },
        {
          "name": "quarter"
        },
        {
          "name": "product"
        },
        {
          "name": "units"
        },
        {
          "name": "amount"
        },
        {
          "name": "avgTicket",
          "expr": "=Fields.amount / Fields.units"
        }
      ],
      "filters": [
        {
          "expr": "=Fields.region",
          "op": "in",
          "value": "=Parameters.Regions"
        },
        {
          "expr": "=Fields.amount",
          "op": ">=",
          "value": "=Parameters.MinAmount"
        }
      ]
    }
