{
 "$schema": "pagewright/report@1",
 "name": "Sales explorer",
 "locale": "en-IN",
 "currency": "INR",
 "page": {
  "size": "A4",
  "orientation": "landscape",
  "margins": [
   28,
   28,
   24,
   28
  ]
 },
 "parameters": [
  {
   "name": "year",
   "type": "number",
   "prompt": "Year",
   "required": true,
   "default": 2026,
   "options": [
    {
     "value": 2025,
     "label": "2025"
    },
    {
     "value": 2026,
     "label": "2026"
    }
   ]
  },
  {
   "name": "regions",
   "type": "string",
   "prompt": "Regions",
   "multi": true,
   "optionsFrom": {
    "dataSet": "Regions",
    "value": "=Fields.name"
   }
  },
  {
   "name": "region",
   "type": "string",
   "prompt": "Focus region (or click a bar)",
   "default": "",
   "optionsFrom": {
    "dataSet": "RegionPick",
    "value": "=Fields.name"
   }
  },
  {
   "name": "product",
   "type": "string",
   "prompt": "Product",
   "default": "",
   "options": [
    {
     "value": "",
     "label": "All products"
    },
    "Home loans",
    "Personal loans",
    "Gold loans"
   ]
  }
 ],
 "dataSources": [
  {
   "name": "sales",
   "type": "rest",
   "method": "GET",
   "url": "/api/sample/sales/{Parameters.year}"
  },
  {
   "name": "prev",
   "type": "rest",
   "method": "GET",
   "url": "/api/sample/sales/{Parameters.year - 1}"
  }
 ],
 "dataSets": [
  {
   "name": "Regions",
   "source": "sales",
   "path": "$.regions",
   "fields": [
    {
     "name": "name",
     "type": "string"
    },
    {
     "name": "cities",
     "type": "number"
    }
   ]
  },
  {
   "name": "RegionPick",
   "source": "sales",
   "path": "$.regions",
   "fields": [
    {
     "name": "name",
     "type": "string"
    }
   ],
   "filters": [
    {
     "expr": "=Fields.name",
     "op": "in",
     "value": "=Parameters.regions"
    }
   ]
  },
  {
   "name": "RegionScope",
   "source": "sales",
   "path": "$.rows",
   "fields": [
    {
     "name": "year",
     "type": "number"
    },
    {
     "name": "month",
     "type": "number"
    },
    {
     "name": "region",
     "type": "string"
    },
    {
     "name": "city",
     "type": "string"
    },
    {
     "name": "product",
     "type": "string"
    },
    {
     "name": "loans",
     "type": "number"
    },
    {
     "name": "disbursed",
     "type": "number"
    },
    {
     "name": "npa",
     "type": "number"
    },
    {
     "name": "crore",
     "type": "number",
     "expr": "=Fields.disbursed / 10000000"
    },
    {
     "name": "lakh",
     "type": "number",
     "expr": "=Fields.disbursed / 100000"
    },
    {
     "name": "monthName",
     "type": "string",
     "expr": "=MonthName(Fields.month, True)"
    }
   ],
   "filters": [
    {
     "expr": "=Fields.region",
     "op": "in",
     "value": "=Parameters.regions"
    },
    {
     "expr": "=Fields.product",
     "op": "in",
     "value": "=Parameters.product"
    }
   ]
  },
  {
   "name": "ProductScope",
   "source": "sales",
   "path": "$.rows",
   "fields": [
    {
     "name": "year",
     "type": "number"
    },
    {
     "name": "month",
     "type": "number"
    },
    {
     "name": "region",
     "type": "string"
    },
    {
     "name": "city",
     "type": "string"
    },
    {
     "name": "product",
     "type": "string"
    },
    {
     "name": "loans",
     "type": "number"
    },
    {
     "name": "disbursed",
     "type": "number"
    },
    {
     "name": "npa",
     "type": "number"
    },
    {
     "name": "crore",
     "type": "number",
     "expr": "=Fields.disbursed / 10000000"
    },
    {
     "name": "lakh",
     "type": "number",
     "expr": "=Fields.disbursed / 100000"
    },
    {
     "name": "monthName",
     "type": "string",
     "expr": "=MonthName(Fields.month, True)"
    }
   ],
   "filters": [
    {
     "expr": "=Fields.region",
     "op": "in",
     "value": "=Parameters.regions"
    },
    {
     "expr": "=Fields.region",
     "op": "in",
     "value": "=Parameters.region"
    }
   ]
  },
  {
   "name": "Sales",
   "source": "sales",
   "path": "$.rows",
   "fields": [
    {
     "name": "year",
     "type": "number"
    },
    {
     "name": "month",
     "type": "number"
    },
    {
     "name": "region",
     "type": "string"
    },
    {
     "name": "city",
     "type": "string"
    },
    {
     "name": "product",
     "type": "string"
    },
    {
     "name": "loans",
     "type": "number"
    },
    {
     "name": "disbursed",
     "type": "number"
    },
    {
     "name": "npa",
     "type": "number"
    },
    {
     "name": "crore",
     "type": "number",
     "expr": "=Fields.disbursed / 10000000"
    },
    {
     "name": "lakh",
     "type": "number",
     "expr": "=Fields.disbursed / 100000"
    },
    {
     "name": "monthName",
     "type": "string",
     "expr": "=MonthName(Fields.month, True)"
    }
   ],
   "filters": [
    {
     "expr": "=Fields.region",
     "op": "in",
     "value": "=Parameters.regions"
    },
    {
     "expr": "=Fields.region",
     "op": "in",
     "value": "=Parameters.region"
    },
    {
     "expr": "=Fields.product",
     "op": "in",
     "value": "=Parameters.product"
    }
   ]
  },
  {
   "name": "Prev",
   "source": "prev",
   "path": "$.rows",
   "fields": [
    {
     "name": "year",
     "type": "number"
    },
    {
     "name": "month",
     "type": "number"
    },
    {
     "name": "region",
     "type": "string"
    },
    {
     "name": "city",
     "type": "string"
    },
    {
     "name": "product",
     "type": "string"
    },
    {
     "name": "loans",
     "type": "number"
    },
    {
     "name": "disbursed",
     "type": "number"
    },
    {
     "name": "npa",
     "type": "number"
    },
    {
     "name": "crore",
     "type": "number",
     "expr": "=Fields.disbursed / 10000000"
    },
    {
     "name": "lakh",
     "type": "number",
     "expr": "=Fields.disbursed / 100000"
    },
    {
     "name": "monthName",
     "type": "string",
     "expr": "=MonthName(Fields.month, True)"
    }
   ],
   "filters": [
    {
     "expr": "=Fields.region",
     "op": "in",
     "value": "=Parameters.regions"
    },
    {
     "expr": "=Fields.region",
     "op": "in",
     "value": "=Parameters.region"
    },
    {
     "expr": "=Fields.product",
     "op": "in",
     "value": "=Parameters.product"
    }
   ]
  }
 ],
