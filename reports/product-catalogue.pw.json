{
 "$schema": "reportwright/report@1",
 "name": "Product catalogue (interactive)",
 "locale": "en-US",
 "currency": "USD",
 "page": {
  "size": "A4",
  "orientation": "landscape",
  "margins": [
   28,
   32,
   24,
   32
  ]
 },
 "parameters": [
  {
   "name": "q",
   "type": "string",
   "prompt": "Search products"
  },
  {
   "name": "categories",
   "type": "string",
   "prompt": "Categories",
   "multi": true,
   "optionsFrom": {
    "dataSet": "Categories",
    "value": "=Fields.slug",
    "label": "=Fields.name"
   }
  },
  {
   "name": "status",
   "type": "string",
   "prompt": "Availability",
   "options": [
    {
     "value": "In Stock",
     "label": "In stock"
    },
    {
     "value": "Low Stock",
     "label": "Low stock"
    },
    {
     "value": "Out of Stock",
     "label": "Out of stock"
    }
   ]
  },
  {
   "name": "brand",
   "type": "string",
   "prompt": "Brand (click one in the table)"
  },
  {
   "name": "minRating",
   "type": "number",
   "prompt": "Minimum rating",
   "required": true,
   "default": 0,
   "options": [
    {
     "value": 0,
     "label": "Any"
    },
    {
     "value": 3,
     "label": "3 ★ and up"
    },
    {
     "value": 4,
     "label": "4 ★ and up"
    },
    {
     "value": 4.5,
     "label": "4.5 ★ and up"
    }
   ]
  },
  {
   "name": "lowStock",
   "type": "number",
   "prompt": "Low-stock alert below",
   "required": true,
   "default": 10,
   "options": [
    {
     "value": 5,
     "label": "5 units"
    },
    {
     "value": 10,
     "label": "10 units"
    },
    {
     "value": 25,
     "label": "25 units"
    },
    {
     "value": 50,
     "label": "50 units"
    }
   ]
  },
  {
   "name": "onlyLow",
   "type": "string",
   "prompt": "Show",
   "options": [
    {
     "value": "yes",
     "label": "Only low or out of stock"
    }
   ]
  }
 ],
 "dataSources": [
  {
   "name": "store",
   "type": "rest",
   "method": "GET",
   "url": "https://dummyjson.com/products?limit=0"
  },
  {
   "name": "cats",
   "type": "rest",
   "method": "GET",
   "url": "https://dummyjson.com/products/categories"
  }
 ],
 "dataSets": [
  {
   "name": "Categories",
   "source": "cats",
   "path": "$",
   "fields": [
    {
     "name": "slug",
     "type": "string"
    },
    {
     "name": "name",
     "type": "string"
    }
   ]
  },
  {
   "name": "Products",
   "source": "store",
   "path": "$.products",
   "fields": [
    {
     "name": "id",
     "type": "number"
    },
    {
     "name": "title",
     "type": "string"
    },
    {
     "name": "category",
     "type": "string"
    },
    {
     "name": "brand",
     "type": "string"
    },
    {
     "name": "price",
     "type": "number"
    },
    {
     "name": "discountPercentage",
     "type": "number"
    },
    {
     "name": "rating",
     "type": "number"
    },
    {
     "name": "stock",
     "type": "number"
    },
    {
     "name": "availabilityStatus",
     "type": "string"
    },
    {
     "name": "sku",
     "type": "string"
    },
    {
     "name": "netPrice",
     "type": "number",
     "expr": "=Round(Fields.price * (1 - Fields.discountPercentage / 100), 2)"
    },
    {
     "name": "stockValue",
     "type": "number",
     "expr": "=Fields.netPrice * Fields.stock"
    }
   ],
   "filters": [
    {
     "expr": "=Fields.category",
     "op": "in",
     "value": "=Parameters.categories"
    },
    {
     "expr": "=Fields.rating",
     "op": ">=",
     "value": "=Parameters.minRating"
    },
    {
     "expr": "=Fields.availabilityStatus",
     "op": "in",
     "value": "=Parameters.status"
    },
    {
     "expr": "=Coalesce(Fields.brand, '')",
     "op": "in",
     "value": "=Parameters.brand"
    },
    {
     "expr": "=Fields.title & ' ' & Coalesce(Fields.brand, '') & ' ' & Fields.category",
     "op": "contains",
     "value": "=Coalesce(Parameters.q, '')"
    },
    {
     "expr": "=IIF(Parameters.onlyLow = 'yes', Fields.stock < Parameters.lowStock, True)",
     "op": "=",
     "value": "=True"
    }
   ],
   "sort": [
    {
     "by": "=Fields.stockValue",
     "dir": "desc"
    }
   ]
  },
  {
   "name": "AllCategories",
   "source": "store",
   "path": "$.products",
   "fields": [
    {
     "name": "id",
     "type": "number"
    },
    {
     "name": "title",
     "type": "string"
    },
    {
     "name": "category",
     "type": "string"
    },
    {
     "name": "brand",
     "type": "string"
    },
    {
     "name": "price",
     "type": "number"
    },
    {
     "name": "discountPercentage",
     "type": "number"
    },
    {
     "name": "rating",
     "type": "number"
    },
    {
     "name": "stock",
     "type": "number"
    },
    {
     "name": "availabilityStatus",
     "type": "string"
    },
    {
     "name": "sku",
     "type": "string"
    },
    {
     "name": "netPrice",
     "type": "number",
     "expr": "=Round(Fields.price * (1 - Fields.discountPercentage / 100), 2)"
    },
    {
     "name": "stockValue",
     "type": "number",
     "expr": "=Fields.netPrice * Fields.stock"
    }
   ],
   "filters": [
    {
     "expr": "=Fields.rating",
     "op": ">=",
     "value": "=Parameters.minRating"
    },
    {
     "expr": "=Fields.availabilityStatus",
     "op": "in",
     "value": "=Parameters.status"
    },
    {
     "expr": "=Coalesce(Fields.brand, '')",
     "op": "in",
     "value": "=Parameters.brand"
    },
    {
     "expr": "=Fields.title & ' ' & Coalesce(Fields.brand, '') & ' ' & Fields.category",
     "op": "contains",
     "value": "=Coalesce(Parameters.q, '')"
    },
    {
     "expr": "=IIF(Parameters.onlyLow = 'yes', Fields.stock < Parameters.lowStock, True)",
     "op": "=",
     "value": "=True"
    }
   ],
   "sort": [
    {
     "by": "=Fields.stockValue",
     "dir": "desc"
    }
   ]
  },
  {
   "name": "AllStatuses",
   "source": "store",
   "path": "$.products",
   "fields": [
    {
     "name": "id",
     "type": "number"
    },
    {
     "name": "title",
     "type": "string"
    },
    {
     "name": "category",
     "type": "string"
    },
    {
     "name": "brand",
     "type": "string"
    },
    {
     "name": "price",
     "type": "number"
    },
    {
     "name": "discountPercentage",
     "type": "number"
    },
    {
     "name": "rating",
     "type": "number"
    },
    {
     "name": "stock",
     "type": "number"
    },
    {
     "name": "availabilityStatus",
     "type": "string"
    },
    {
     "name": "sku",
     "type": "string"
    },
    {
     "name": "netPrice",
     "type": "number",
     "expr": "=Round(Fields.price * (1 - Fields.discountPercentage / 100), 2)"
    },
    {
     "name": "stockValue",
     "type": "number",
     "expr": "=Fields.netPrice * Fields.stock"
    }
   ],
   "filters": [
    {
     "expr": "=Fields.category",
     "op": "in",
     "value": "=Parameters.categories"
    },
    {
     "expr": "=Fields.rating",
     "op": ">=",
     "value": "=Parameters.minRating"
    },
    {
     "expr": "=Coalesce(Fields.brand, '')",
     "op": "in",
     "value": "=Parameters.brand"
    },
    {
     "expr": "=Fields.title & ' ' & Coalesce(Fields.brand, '') & ' ' & Fields.category",
     "op": "contains",
     "value": "=Coalesce(Parameters.q, '')"
    },
    {
     "expr": "=IIF(Parameters.onlyLow = 'yes', Fields.stock < Parameters.lowStock, True)",
     "op": "=",
     "value": "=True"
    }
   ],
   "sort": [
    {
     "by": "=Fields.stockValue",
     "dir": "desc"
    }
   ]
  }
 ],
 "styles": {
  "base": {
   "fontFamily": "Inter",
   "fontSize": 8,
   "color": "#16202a"
