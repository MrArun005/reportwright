{
  "$schema": "pagewright/report@1",
  "name": "Sales by region",
  "locale": "en-IN",
  "currency": "INR",
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margins": [
      36,
      36,
      30,
      36
    ]
  },
  "parameters": [
    {
      "name": "year",
      "type": "number",
      "prompt": "Year",
      "required": true,
      "default": 2026,
      "options": [
        {
          "value": 2025,
          "label": "2025"
        },
        {
          "value": 2026,
          "label": "2026"
        }
      ]
    },
    {
      "name": "regions",
      "type": "string",
      "prompt": "Regions",
      "multi": true,
      "optionsFrom": {
        "dataSet": "Regions",
        "value": "=Fields.name"
      }
    }
  ],
  "dataSources": [
    {
      "name": "sales",
      "type": "rest",
      "method": "GET",
      "url": "/api/sample/sales/{Parameters.year}"
    }
  ],
  "dataSets": [
    {
      "name": "Regions",
      "source": "sales",
      "path": "$.regions",
      "fields": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "cities",
          "type": "number"
        }
      ]
    },
    {
      "name": "Sales",
      "source": "sales",
      "path": "$.rows",
      "fields": [
        {
          "name": "year",
          "type": "number"
        },
        {
          "name": "month",
          "type": "number"
        },
        {
          "name": "region",
          "type": "string"
        },
        {
          "name": "city",
          "type": "string"
        },
        {
          "name": "product",
          "type": "string"
        },
        {
          "name": "loans",
          "type": "number"
        },
        {
          "name": "disbursed",
          "type": "number"
        },
        {
          "name": "npa",
          "type": "number"
        },
        {
          "name": "crore",
          "type": "number",
          "expr": "=Fields.disbursed / 10000000"
        }
      ],
      "filters": [
        {
          "expr": "=Fields.region",
          "op": "in",
          "value": "=Parameters.regions"
        }
      ]
    }
  ],
  "styles": {
    "base": {
      "fontFamily": "Inter",
      "fontSize": 8.5,
      "color": "#111827"
    }
  },
  "sections": {
    "pageHeader": {
      "height": 34,
      "items": [
        {
          "type": "textbox",
          "name": "Brand",
          "x": 0,
          "y": 0,
          "w": 300,
          "h": 16,
          "value": "Pagewright Finance · Sales",
          "canGrow": true,
          "style": {
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#1d4ed8"
          }
        },
        {
          "type": "textbox",
          "name": "Year",
          "x": 323.28,
          "y": 2,
          "w": 200,
          "h": 12,
          "value": "Financial year {Parameters.year}",
          "canGrow": true,
          "style": {
            "fontSize": 8,
            "color": "#6b7280",
            "textAlign": "right"
          }
        },
        {
          "type": "line",
          "name": "Rule",
          "x": 0,
          "y": 24,
          "w": 523.28,
          "h": 0,
          "style": {
            "stroke": "#d1d5db",
            "strokeWidth": 0.75
          }
        }
      ]
    },
    "body": {
      "height": 200,
      "items": [
        {
          "type": "textbox",
          "name": "Title",
          "x": 0,
          "y": 0,
          "w": 400,
          "h": 24,
          "value": "Disbursements by region",
          "canGrow": true,
          "style": {
            "fontSize": 16,
            "fontWeight": "bold"
          }
        },
        {
          "type": "textbox",
          "name": "Sub",
          "x": 0,
          "y": 25,
          "w": 520,
          "h": 14,
          "value": "Regions: {IIF(Len(Join(Parameters.regions, ', ')) = 0, 'all', Join(Parameters.regions, ', '))} · amounts in ₹ crore · click ▶ to open a city",
          "canGrow": true,
          "style": {
            "fontSize": 8,
            "color": "#6b7280"
          }
        },
        {
          "type": "table",
          "name": "Breakdown",
          "x": 0,
          "y": 50,
          "w": 523.28,
          "h": 90,
          "dataSet": "Sales",
          "repeatHeader": true,
          "columns": [
            {
              "width": 170
            },
            {
              "width": 90
            },
            {
              "width": 80
            },
            {
              "width": 90
            },
            {
              "width": 93.28
            }
          ],
          "style": {
            "padding": [
              3,
              5,
              3,
              5
            ]
          },
          "header": [
            {
              "height": 18,
              "style": {
                "fontWeight": "bold",
                "color": "#fff",
                "backgroundColor": "#1d4ed8",
                "verticalAlign": "middle"
              },
              "cells": [
                {
                  "value": "Region / city / product",
                  "sortBy": "=Fields.region"
                },
                {
                  "value": "Loans",
                  "style": {
                    "textAlign": "right"
                  },
                  "sortBy": "=Fields.loans"
                },
                {
                  "value": "NPA %",
                  "style": {
                    "textAlign": "right"
                  }
                },
                {
                  "value": "₹ crore",
                  "style": {
                    "textAlign": "right"
                  },
                  "sortBy": "=Fields.disbursed"
                },
                {
                  "value": "Share",
                  "style": {
                    "textAlign": "right"
                  }
                }
              ]
            }
          ],
          "groups": [
            {
              "name": "Region",
              "expr": "=Fields.region",
              "sort": "asc",
              "keepTogether": false,
              "pageBreak": "",
              "header": [
                {
                  "height": 20,
                  "style": {
                    "fontWeight": "bold",
                    "fontSize": 10,
                    "backgroundColor": "#eff6ff",
                    "borderTop": "1 solid #1d4ed8"
                  },
                  "cells": [
                    {
                      "value": "=Fields.region",
                      "bookmark": "=Fields.region"
                    },
                    {
                      "value": "=Sum(Fields.loans)",
                      "style": {
                        "textAlign": "right",
                        "format": "N0"
                      }
                    },
                    {
                      "value": "=Avg(Fields.npa)",
                      "style": {
                        "textAlign": "right",
                        "format": "N2"
                      }
                    },
                    {
                      "value": "=Sum(Fields.crore)",
                      "style": {
                        "textAlign": "right",
                        "format": "N1"
                      }
                    },
                    {
                      "value": "=Sum(Fields.disbursed) / Sum(Fields.disbursed, \"Breakdown\")",
                      "style": {
                        "textAlign": "right",
                        "format": "P1"
                      }
                    }
                  ]
                }
              ],
              "footer": []
            },
            {
              "name": "City",
              "expr": "=Fields.city",
              "sort": "asc",
              "collapsible": true,
              "initiallyCollapsed": true,
              "header": [
                {
                  "height": 17,
                  "style": {
                    "fontWeight": "600",
                    "borderBottom": "0.5 solid #e5e7eb"
                  },
                  "cells": [
                    {
                      "value": "=Fields.city",
                      "style": {
                        "padding": [
                          3,
                          5,
                          3,
                          14
                        ]
                      }
                    },
                    {
                      "value": "=Sum(Fields.loans)",
                      "style": {
                        "textAlign": "right",
                        "format": "N0"
                      }
                    },
                    {
                      "value": "=Avg(Fields.npa)",
                      "style": {
                        "textAlign": "right",
                        "format": "N2",
                        "color": "=IIF(Avg(Fields.npa) > 2.2, '#b91c1c', '#111827')"
                      }
                    },
                    {
                      "value": "=Sum(Fields.crore)",
                      "style": {
                        "textAlign": "right",
                        "format": "N1"
                      }
                    },
                    {
                      "value": "=Sum(Fields.disbursed) / Sum(Fields.disbursed, \"Region\")",
                      "style": {
                        "textAlign": "right",
                        "format": "P1"
                      }
                    }
                  ]
                }
              ],
              "footer": []
            },
            {
              "name": "Product",
              "expr": "=Fields.product",
              "sort": "asc",
              "header": [
                {
                  "height": 15,
                  "style": {
                    "color": "#374151",
                    "borderBottom": "0.5 solid #f3f4f6"
                  },
                  "cells": [
                    {
                      "value": "=Fields.product",
                      "style": {
                        "padding": [
                          3,
                          5,
                          3,
                          26
                        ]
                      }
                    },
                    {
                      "value": "=Sum(Fields.loans)",
                      "style": {
                        "textAlign": "right",
                        "format": "N0"
                      }
                    },
                    {
                      "value": "=Avg(Fields.npa)",
                      "style": {
                        "textAlign": "right",
                        "format": "N2"
                      }
                    },
                    {
                      "value": "=Sum(Fields.crore)",
                      "style": {
                        "textAlign": "right",
                        "format": "N2"
                      }
                    },
                    {
                      "value": "=Sum(Fields.disbursed) / Sum(Fields.disbursed, \"City\")",
                      "style": {
                        "textAlign": "right",
                        "format": "P1"
                      }
                    }
                  ]
                }
              ],
              "footer": []
            }
          ],
          "detail": [],
          "footer": [
            {
              "height": 22,
              "style": {
                "fontWeight": "bold",
                "fontSize": 10,
                "borderTop": "1.5 solid #1d4ed8",
                "verticalAlign": "middle"
              },
              "cells": [
                {
                  "value": "All regions"
                },
                {
                  "value": "=Sum(Fields.loans)",
                  "style": {
                    "textAlign": "right",
                    "format": "N0"
                  }
                },
                {
                  "value": "=Avg(Fields.npa)",
                  "style": {
                    "textAlign": "right",
                    "format": "N2"
                  }
                },
                {
                  "value": "=Sum(Fields.crore)",
                  "style": {
                    "textAlign": "right",
                    "format": "N1"
                  }
                },
                {
                  "value": "100.0%",
                  "style": {
                    "textAlign": "right"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "pageFooter": {
      "height": 22,
      "items": [
        {
          "type": "textbox",
          "name": "Gen",
          "x": 0,
          "y": 6,
          "w": 300,
          "h": 12,
          "value": "Generated {Format(Globals.ExecutionTime, 'dd MMM yyyy, hh:mm tt')}",
          "canGrow": true,
          "style": {
            "fontSize": 7,
            "color": "#6b7280"
          }
        },
        {
          "type": "textbox",
          "name": "Pg",
          "x": 323.28,
          "y": 6,
          "w": 200,
          "h": 12,
          "value": "Page {Globals.PageNumber} of {Globals.TotalPages}",
          "canGrow": true,
          "style": {
            "fontSize": 7,
            "color": "#6b7280",
            "textAlign": "right"
          }
        }
      ]
    }
  }
}