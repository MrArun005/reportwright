{
  "$schema": "reportwright/report@1",
  "name": "Stress ledger",
  "locale": "en-IN",
  "currency": "INR",
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margins": [
      36,
      36,
      36,
      36
    ]
  },
  "parameters": [
    {
      "name": "regions",
      "type": "string",
      "prompt": "Regions",
      "required": false,
      "multi": true,
      "optionsFrom": {
        "dataSet": "Regions",
        "value": "=Fields.name"
      },
      "editor": "list"
    },
    {
      "name": "branches",
      "type": "string",
      "prompt": "Branches (cascade from regions)",
      "required": false,
      "multi": true,
      "optionsFrom": {
        "dataSet": "Branches",
        "value": "=Fields.id"
      },
      "editor": "list"
    },
    {
      "name": "amountRange",
      "type": "number",
      "prompt": "Amount in INR (from, to)",
      "default": "-20000000000,20000000000",
      "required": false,
      "editor": "range",
      "multi": true,
      "min": -20000000000,
      "max": 20000000000,
      "step": 1000000
    },
    {
      "name": "dateRange",
      "type": "date",
      "prompt": "Trend chart dates",
      "default": "2024-01-01,2026-12-31",
      "required": false,
      "editor": "dateRange",
      "multi": true,
      "min": "2024-01-01",
      "max": "2026-12-31"
    },
    {
      "name": "topN",
      "type": "number",
      "prompt": "Top N accounts",
      "default": "10",
      "required": false,
      "editor": "slider",
      "min": 3,
      "max": 25,
      "step": 1
    },
    {
      "name": "highlight",
      "type": "boolean",
      "prompt": "Highlight large movements",
      "default": "true",
      "required": false,
      "editor": "toggle"
    },
    {
      "name": "focusType",
      "type": "string",
      "prompt": "Focus transaction type (chart click)",
      "required": false
    }
  ],
  "dataSources": [
    {
      "name": "hard",
      "type": "rest",
      "url": "/api/sample/hard?rows=5000",
      "method": "GET"
    }
  ],
  "dataSets": [
    {
      "name": "Regions",
      "source": "hard",
      "path": "$.regions",
      "fields": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "branches",
          "type": "number"
        }
      ]
    },
    {
      "name": "FX",
      "source": "hard",
      "path": "$.fx",
      "fields": [
        {
          "name": "currency",
          "type": "string"
        },
        {
          "name": "toInr",
          "type": "number"
        }
      ]
    },
    {
      "name": "Branches",
      "source": "hard",
      "path": "$.branches",
      "fields": [
        {
          "name": "id",
          "type": "string"
        },
        {
          "name": "region",
          "type": "string"
        },
        {
          "name": "city",
          "type": "string"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "opened",
          "type": "date"
        },
        {
          "name": "target",
          "type": "number"
        },
        {
          "name": "manager",
          "type": "string"
        }
      ],
      "filters": [
        {
          "expr": "=Fields.region",
          "op": "in",
          "value": "=Parameters.regions"
        }
      ],
      "sort": [
        {
          "by": "=Fields.id",
          "dir": "asc"
        }
      ]
    },
    {
      "name": "Transactions",
      "source": "hard",
      "path": "$.transactions",
      "fields": [
        {
          "name": "id",
          "type": "number"
        },
        {
          "name": "accountId",
          "type": "string"
        },
        {
          "name": "region",
          "type": "string"
        },
        {
          "name": "branchId",
          "type": "string"
        },
        {
          "name": "date",
          "type": "date"
        },
        {
          "name": "type",
          "type": "string"
        },
        {
          "name": "amount",
          "type": "number"
        },
        {
          "name": "currency",
          "type": "string"
        },
        {
          "name": "channel",
          "type": "string"
        },
        {
          "name": "reference",
          "type": "string"
        },
        {
          "name": "ok",
          "type": "string"
        },
        {
          "name": "amountInr",
          "type": "number",
          "expr": "=Fields.amount * Coalesce(Lookup(Fields.currency, Fields.currency, Fields.toInr, \"FX\"), 1)"
        },
        {
          "name": "txDate",
          "type": "date",
          "expr": "=CDate(Fields.date)"
        },
        {
          "name": "month",
          "type": "string",
          "expr": "=Format(CDate(Fields.date), \"yyyy-MM\")"
        },
        {
          "name": "channelClean",
          "type": "string",
          "expr": "=IIF(Trim(Coalesce(Fields.channel, \"\")) = \"\", \"(none)\", Fields.channel)"
        },
        {
          "name": "isCredit",
          "type": "boolean",
          "expr": "=Fields.amount < 0"
        }
      ],
      "filters": [
        {
          "expr": "=Fields.region",
          "op": "in",
          "value": "=Parameters.regions"
        },
        {
          "expr": "=Fields.branchId",
          "op": "in",
          "value": "=Parameters.branches"
        },
        {
          "expr": "=Fields.amountInr",
          "op": "Between",
          "value": "=Parameters.amountRange[0]",
          "value2": "=Parameters.amountRange[1]"
        }
      ],
      "sort": [
        {
          "by": "=Fields.id",
          "dir": "asc"
        }
      ]
    },
    {
      "name": "TrendTx",
      "source": "hard",
      "path": "$.transactions",
      "fields": [
        {
          "name": "id",
          "type": "number"
        },
        {
          "name": "accountId",
          "type": "string"
        },
        {
          "name": "region",
          "type": "string"
        },
        {
          "name": "branchId",
          "type": "string"
        },
        {
          "name": "date",
          "type": "date"
        },
        {
          "name": "type",
          "type": "string"
        },
        {
          "name": "amount",
          "type": "number"
        },
        {
          "name": "currency",
          "type": "string"
        },
        {
          "name": "channel",
          "type": "string"
        },
        {
          "name": "reference",
          "type": "string"
        },
        {
          "name": "ok",
          "type": "string"
        },
        {
          "name": "amountInr",
          "type": "number",
          "expr": "=Fields.amount * Coalesce(Lookup(Fields.currency, Fields.currency, Fields.toInr, \"FX\"), 1)"
        },
        {
          "name": "txDate",
          "type": "date",
          "expr": "=CDate(Fields.date)"
        },
        {
          "name": "month",
          "type": "string",
          "expr": "=Format(CDate(Fields.date), \"yyyy-MM\")"
        }
      ],
      "filters": [
        {
          "expr": "=Fields.region",
          "op": "in",
          "value": "=Parameters.regions"
        },
        {
          "expr": "=Fields.txDate",
          "op": "Between",
          "value": "=Parameters.dateRange[0]",
          "value2": "=Parameters.dateRange[1]"
        }
      ]
    },
    {
      "name": "TopAccounts",
      "source": "hard",
      "path": "$.accounts",
      "fields": [
        {
          "name": "accountId",
          "type": "string"
        },
        {
          "name": "branchId",
          "type": "string"
        },
        {
          "name": "region",
          "type": "string"
        },
        {
          "name": "product",
          "type": "string"
        },
        {
          "name": "customer",
          "type": "string"
        },
        {
          "name": "city",
          "type": "string"
        },
        {
          "name": "principal",
          "type": "number"
        },
        {
          "name": "rate",
          "type": "number"
        },
        {
          "name": "months",
          "type": "number"
        },
        {
          "name": "emi",
          "type": "number"
        },
        {
          "name": "disbursed",
          "type": "date"
        },
        {
          "name": "lastPayment",
          "type": "string"
        },
        {
          "name": "status",
          "type": "string"
        },
        {
          "name": "dpd",
          "type": "number"
        },
        {
          "name": "outstanding",
          "type": "number"
        },
        {
          "name": "score",
          "type": "string"
        },
        {
          "name": "notes",
          "type": "string"
        },
        {
          "name": "tags",
          "type": "string"
        }
      ],
      "filters": [
        {
          "expr": "=Fields.region",
          "op": "in",
          "value": "=Parameters.regions"
        },
        {
          "expr": "=Fields.branchId",
          "op": "in",
          "value": "=Parameters.branches"
        },
        {
          "expr": "=Fields.outstanding",
          "op": "TopN",
          "value": "=Parameters.topN"
        }
      ],
      "sort": [
        {
          "by": "=Fields.outstanding",
          "dir": "desc"
        }
      ]
    }
  ],
  "styles": {
    "base": {
      "fontFamily": "Inter",
      "fontSize": 9,
      "color": "#1f2937"
    }
  },
  "sections": {
    "pageHeader": {
      "height": 36,
      "items": [
        {
          "id": "h1",
          "type": "textbox",
          "name": "ReportTitle",
          "x": 0,
          "y": 0,
          "w": 320,
          "h": 22,
          "value": "Stress ledger",
          "canGrow": true,
          "style": {
            "fontSize": 14,
            "fontWeight": "bold"
          }
        },
        {
          "type": "textbox",
          "w": 193,
          "h": 26,
          "value": "=\"Regions: \" & IIF(Count(Parameters.regions) = 0, \"all\", Join(Parameters.regions, \", \")) & \" · branches: \" & IIF(Len(Join(Parameters.branches, \",\")) = 0, \"all\", Join(Parameters.branches, \", \"))",
          "canGrow": true,
          "canShrink": false,
          "style": {
            "fontSize": 7,
            "textAlign": "right"
          },
          "id": "kg0sj2ca",
          "name": "ParamSummary",
          "x": 330,
          "y": 4
        }
      ]
    },
    "body": [
      {
        "name": "Section1",
        "height": 1204,
        "items": [
          {
            "type": "textbox",
