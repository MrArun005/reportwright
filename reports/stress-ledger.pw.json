          },
          {
            "type": "richtext",
            "w": 263,
            "h": 90,
            "value": "<h3>What this run holds</h3><p><b>{Format(CountRows(), \"N0\")}</b> transactions on <b>{CountDistinct(Fields.accountId)}</b> accounts, net <span style=\"color:#b91c1c\"><b>{Format(Sum(Fields.amountInr), \"N0\")}</b></span> INR.</p><ul><li>Largest credit: <i>{Format(Min(Fields.amountInr), \"N0\")}</i></li><li>Largest debit: <i>{Format(Max(Fields.amountInr), \"N0\")}</i></li><li>Missing currency on <u>{CountRows() - Count(Fields.currency)}</u> rows</li></ul>",
            "canGrow": true,
            "style": {},
            "id": "tz3bc76d",
            "name": "SummaryText",
            "x": 260,
            "y": 26,
            "dataSet": "Transactions"
          },
