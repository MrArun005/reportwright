{
  "name": "pagewright",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/build-embed.mjs && next build",
    "start": "next start -p 3000",
    "test": "vitest run",
    "lint:engine": "node scripts/check-engine-boundary.mjs",
    "test:e2e": "for t in build-from-scratch smoke expr-editor phase2 phase3 phase4 api; do node tests/e2e/$t.mjs || exit 1; done",
    "sample": "node scripts/make-sample.mjs",
    "build:embed": "node scripts/build-embed.mjs",
    "perf": "node scripts/perf.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@pdf-lib/fontkit": "^1.1.1",
    "bwip-js": "^4.11.4",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "harfbuzzjs": "^1.6.2",
    "immer": "^11.1.21",
    "next": "^16.3.8",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "optionalDependencies": {
    "mysql2": "^3.24.5",
    "pg": "^8.23.1"
  }
}
