{
  "name": "pagewright",
  "version": "0.6.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "pw": "bin/pw.mjs"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/build-embed.mjs && node scripts/build-worker.mjs && next build",
    "start": "next start -p 3000",
    "test": "vitest run",
    "pw": "node bin/pw.mjs",
    "test:reports": "node bin/pw.mjs test reports",
    "lint:engine": "node scripts/check-engine-boundary.mjs",
    "test:e2e": "for t in build-from-scratch smoke expr-editor phase2 phase3 phase4 api progressive phase-bc data-setup galleries charts-p5 tablix ai designer-gaps reuse ssrs-import outline-charts layout-charts-b4; do node tests/e2e/$t.mjs || exit 1; done",
    "sample": "node scripts/make-sample.mjs",
    "build:embed": "node scripts/build-embed.mjs",
    "build:packages": "node scripts/build-embed.mjs && node scripts/build-packages.mjs",
    "perf": "node scripts/perf.mjs",
    "build:site": "node scripts/build-site.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@node-saml/node-saml": "^5.1.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "bidi-js": "~1.0.3",
    "bwip-js": "^4.11.4",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "harfbuzzjs": "^1.6.2",
    "immer": "^11.1.21",
    "jose": "^6.2.12",
    "next": "^16.3.8",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "xml-crypto": "^6.3.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "optionalDependencies": {
    "mssql": "^12.7.2",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1"
  }
}
