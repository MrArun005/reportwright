<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="MarkupRotation" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<field name="name" class="java.lang.String"/>
	<field name="note" class="java.lang.String"/>
	<title><band height="200">
		<staticText><reportElement x="0" y="0" width="300" height="20"/><textElement markup="html"/><text><![CDATA[Hello <b>bold</b> <font color="#ff0000" size="4">red</font> x<sup>2</sup> <marquee>moving</marquee>]]></text></staticText>
		<staticText><reportElement x="0" y="20" width="300" height="20"/><textElement markup="styled"/><text><![CDATA[<style isItalic="true" forecolor="#0000ff">Styled blue</style> plain]]></text></staticText>
		<staticText><reportElement x="0" y="40" width="300" height="20"/><textElement markup="rtf"/><text><![CDATA[{\rtf1\ansi{\fonttbl{\f0 Arial;}}\f0 Rtf \b strong\b0  text}]]></text></staticText>
		<textField><reportElement x="0" y="60" width="300" height="20"/><textElement markup="html"/><textFieldExpression><![CDATA["<i>Literal</i> html"]]></textFieldExpression></textField>
		<staticText><reportElement x="400" y="0" width="20" height="120"/><textElement rotation="Left"/><text><![CDATA[Upwards]]></text></staticText>
		<staticText><reportElement x="430" y="0" width="20" height="120"/><textElement rotation="Right"/><text><![CDATA[Downwards]]></text></staticText>
		<staticText><reportElement x="460" y="0" width="80" height="20"/><textElement rotation="UpsideDown"/><text><![CDATA[Flipped]]></text></staticText>
	</band></title>
	<detail><band height="20">
		<textField><reportElement x="0" y="0" width="200" height="20"/><textElement markup="html"/><textFieldExpression><![CDATA[$F{note}]]></textFieldExpression></textField>
		<textField><reportElement x="200" y="0" width="200" height="20"/><textElement markup="styled"/><textFieldExpression><![CDATA[$F{name} + "!"]]></textFieldExpression></textField>
	</band></detail>
</jasperReport>
