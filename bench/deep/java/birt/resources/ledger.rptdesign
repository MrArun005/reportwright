<?xml version="1.0" encoding="UTF-8"?>
<!-- The ledger report of bench/deep (README.md) as an Eclipse BIRT design, the equivalent of java/jasper/resources/ledger.jrxml:
     the column header repeats on every page, the Region group has a header and a footer with COUNT and SUM aggregations,
     the table footer holds the grand total, the master page footer "Page N of M" (page-number and total-page auto-text).
     Rows come from a scripted data set whose event handler is Java (bench.Birt$Rows), no JavaScript per row. -->
<report xmlns="http://www.eclipse.org/birt/2005/design" version="3.2.27" id="1">
<property name="units">pt</property>
<data-sources><script-data-source name="Src" id="2"/></data-sources>
<data-sets><script-data-set name="Ledger" id="3">
<list-property name="resultSetHints"><structure><property name="position">1</property><property name="name">id</property><property name="dataType">integer</property></structure><structure><property name="position">2</property><property name="name">account</property><property name="dataType">string</property></structure><structure><property name="position">3</property><property name="name">region</property><property name="dataType">string</property></structure><structure><property name="position">4</property><property name="name">type</property><property name="dataType">string</property></structure><structure><property name="position">5</property><property name="name">date</property><property name="dataType">string</property></structure><structure><property name="position">6</property><property name="name">amount</property><property name="dataType">float</property></structure><structure><property name="position">7</property><property name="name">reference</property><property name="dataType">string</property></structure></list-property>
<structure name="cachedMetaData"><list-property name="resultSet"><structure><property name="position">1</property><property name="name">id</property><property name="dataType">integer</property></structure><structure><property name="position">2</property><property name="name">account</property><property name="dataType">string</property></structure><structure><property name="position">3</property><property name="name">region</property><property name="dataType">string</property></structure><structure><property name="position">4</property><property name="name">type</property><property name="dataType">string</property></structure><structure><property name="position">5</property><property name="name">date</property><property name="dataType">string</property></structure><structure><property name="position">6</property><property name="name">amount</property><property name="dataType">float</property></structure><structure><property name="position">7</property><property name="name">reference</property><property name="dataType">string</property></structure></list-property></structure>
<property name="eventHandlerClass">bench.Birt$Rows</property>
<property name="dataSource">Src</property>
</script-data-set></data-sets>
<styles><style name="report" id="4"><property name="fontFamily">"Inter"</property><property name="fontSize">9pt</property></style></styles>
<page-setup><simple-master-page name="Page" id="5">
<property name="type">a4</property>
<property name="topMargin">36pt</property><property name="leftMargin">36pt</property><property name="bottomMargin">36pt</property><property name="rightMargin">36pt</property>
<property name="showHeaderOnFirst">false</property><property name="headerHeight">0pt</property><property name="footerHeight">18pt</property>
<page-footer><grid id="6"><property name="width">523pt</property>
<column id="7"><property name="width">440pt</property></column><column id="8"><property name="width">30pt</property></column><column id="9"><property name="width">14pt</property></column><column id="11"><property name="width">39pt</property></column>
<row id="20"><property name="height">18pt</property><cell id="22"><property name="paddingLeft">0pt</property><property name="paddingRight">0pt</property><property name="paddingTop">0pt</property><property name="paddingBottom">0pt</property><property name="verticalAlign">middle</property><property name="textAlign">right</property><label id="21"><text-property name="text">Page</text-property></label></cell><cell id="24"><property name="paddingLeft">3pt</property><property name="paddingRight">0pt</property><property name="paddingTop">0pt</property><property name="paddingBottom">0pt</property><property name="verticalAlign">middle</property><auto-text id="23"><property name="type">page-number</property></auto-text></cell><cell id="26"><property name="paddingLeft">3pt</property><property name="paddingRight">0pt</property><property name="paddingTop">0pt</property><property name="paddingBottom">0pt</property><property name="verticalAlign">middle</property><label id="25"><text-property name="text">of</text-property></label></cell><cell id="28"><property name="paddingLeft">3pt</property><property name="paddingRight">0pt</property><property name="paddingTop">0pt</property><property name="paddingBottom">0pt</property><property name="verticalAlign">middle</property><auto-text id="27"><property name="type">total-page</property></auto-text></cell></row>
</grid></page-footer>
</simple-master-page></page-setup>
<body><table id="29" name="Ledger">
<property name="width">523pt</property><property name="dataSet">Ledger</property><property name="pageBreakInterval">0</property><property name="repeatHeader">true</property>
<list-property name="boundDataColumns"><structure><property name="name">id</property><expression name="expression" type="javascript">dataSetRow["id"]</expression><property name="dataType">integer</property></structure><structure><property name="name">account</property><expression name="expression" type="javascript">dataSetRow["account"]</expression><property name="dataType">string</property></structure><structure><property name="name">region</property><expression name="expression" type="javascript">dataSetRow["region"]</expression><property name="dataType">string</property></structure><structure><property name="name">type</property><expression name="expression" type="javascript">dataSetRow["type"]</expression><property name="dataType">string</property></structure><structure><property name="name">date</property><expression name="expression" type="javascript">dataSetRow["date"]</expression><property name="dataType">string</property></structure><structure><property name="name">amount</property><expression name="expression" type="javascript">dataSetRow["amount"]</expression><property name="dataType">float</property></structure><structure><property name="name">reference</property><expression name="expression" type="javascript">dataSetRow["reference"]</expression><property name="dataType">string</property></structure><structure><property name="name">regionLabel</property><expression name="expression" type="javascript">"Region " + dataSetRow["region"]</expression><property name="dataType">string</property></structure><structure><property name="name">gCount</property><property name="dataType">integer</property><simple-property-list name="aggregateOn"><value>Region</value></simple-property-list><property name="aggregateFunction">COUNT</property><list-property name="arguments"><structure><property name="name">Expression</property><expression name="value" type="javascript">row["id"]</expression></structure></list-property></structure><structure><property name="name">gSum</property><property name="dataType">float</property><simple-property-list name="aggregateOn"><value>Region</value></simple-property-list><property name="aggregateFunction">SUM</property><list-property name="arguments"><structure><property name="name">Expression</property><expression name="value" type="javascript">row["amount"]</expression></structure></list-property></structure><structure><property name="name">tCount</property><property name="dataType">integer</property><property name="aggregateFunction">COUNT</property><list-property name="arguments"><structure><property name="name">Expression</property><expression name="value" type="javascript">row["id"]</expression></structure></list-property></structure><structure><property name="name">tSum</property><property name="dataType">float</property><property name="aggregateFunction">SUM</property><list-property name="arguments"><structure><property name="name">Expression</property><expression name="value" type="javascript">row["amount"]</expression></structure></list-property></structure></list-property>
<column id="30"><property name="width">50pt</property></column><column id="31"><property name="width">62pt</property></column><column id="32"><property name="width">50pt</property></column><column id="33"><property name="width">62pt</property></column><column id="34"><property name="width">62pt</property></column><column id="35"><property name="width">70pt</property></column><column id="36"><property name="width">167pt</property></column>
<header><row id="51"><property name="height">16pt</property><property name="backgroundColor">#EEF2F7</property><property name="fontWeight">bold</property><cell id="38"><property name="paddingTop">0pt</property><property name="paddingBottom">0pt</property><property name="paddingLeft">2pt</property><property name="paddingRight">2pt</property><property name="verticalAlign">middle</property><label id="37"><text-property name="text">Id</text-property></label></cell><cell id="40"><property name="paddingTop">0pt</property><property name="paddingBottom">0pt</property><property name="paddingLeft">2pt</property><property name="paddingRight">2pt</property><property name="verticalAlign">middle</property><label id="39"><text-property name="text">Account</text-property></label></cell><cell id="42"><property name="paddingTop">0pt</property><property name="paddingBottom">0pt</property><property name="paddingLeft">2pt</property><property name="paddingRight">2pt</property><property name="verticalAlign">middle</property><label id="41"><text-property name="text">Region</text-property></label></cell><cell id="44"><property name="paddingTop">0pt</property><property name="paddingBottom">0pt</property><property name="paddingLeft">2pt</property><property name="paddingRight">2pt</property><property name="verticalAlign">middle</property><label id="43"><text-property name="text">Type</text-property></label></cell><cell id="46"><property name="paddingTop">0pt</property><property name="paddingBottom">0pt</property><property name="paddingLeft">2pt</property><property name="paddingRight">2pt</property><property name="verticalAlign">middle</property><label id="45"><text-property name="text">Date</text-property></label></cell><cell id="48"><property name="paddingTop">0pt</property><property name="paddingBottom">0pt</property><property name="paddingLeft">2pt</property><property name="paddingRight">2pt</property><property name="verticalAlign">middle</property><property name="textAlign">right</property><label id="47"><text-property name="text">Amount</text-property></label></cell><cell id="50"><property name="paddingTop">0pt</property><property name="paddingBottom">0pt</property><property name="paddingLeft">2pt</property><property name="paddingRight">2pt</property><property name="verticalAlign">middle</property><label id="49"><text-property name="text">Reference</text-property></label></cell></row></header>
<group id="52"><property name="groupName">Region</property><property name="interval">none</property><property name="sortType">none</property>
<expression name="keyExpr" type="javascript">row["region"]</expression>
<header><row id="55"><property name="height">16pt</property><property name="backgroundColor">#DBEAFE</property><property name="fontWeight">bold</property><cell id="54"><property name="colSpan">7</property><property name="paddingTop">0pt</property><property name="paddingBottom">0pt</property><property name="paddingLeft">2pt</property><property name="paddingRight">2pt</property><property name="verticalAlign">middle</property><data id="53"><property name="resultSetColumn">regionLabel</property></data></cell></row></header>
<footer><row id="64"><property name="height">14pt</property><property name="fontWeight">bold</property><cell id="57"><property name="colSpan">2</property><property name="paddingTop">0pt</property><property name="paddingBottom">0pt</property><property name="paddingLeft">2pt</property><property name="paddingRight">2pt</property><property name="verticalAlign">middle</property><label id="56"><text-property name="text">Region total</text-property></label></cell><cell id="59"><property name="paddingTop">0pt</property><property name="paddingBottom">0pt</property><property name="paddingLeft">2pt</property><property name="paddingRight">2pt</property><property name="verticalAlign">middle</property><data id="58"><property name="resultSetColumn">gCount</property></data></cell><cell id="60"><property name="colSpan">2</property><property name="paddingTop">0pt</property><property name="paddingBottom">0pt</property><property name="paddingLeft">2pt</property><property name="paddingRight">2pt</property><property name="verticalAlign">middle</property></cell><cell id="62"><property name="paddingTop">0pt</property><property name="paddingBottom">0pt</property><property name="paddingLeft">2pt</property><property name="paddingRight">2pt</property><property name="verticalAlign">middle</property><property name="textAlign">right</property><data id="61"><structure name="numberFormat"><property name="category">Custom</property><property name="pattern">#,##0.00</property></structure><property name="resultSetColumn">gSum</property></data></cell><cell id="63"><property name="paddingTop">0pt</property><property name="paddingBottom">0pt</property><property name="paddingLeft">2pt</property><property name="paddingRight">2pt</property><property name="verticalAlign">middle</property></cell></row></footer>
</group>
