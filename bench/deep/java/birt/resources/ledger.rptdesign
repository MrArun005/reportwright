<footer><row id="88"><property name="height">14pt</property><property name="fontWeight">bold</property><cell id="81"><property name="colSpan">2</property><property name="paddingTop">0pt</property><property name="paddingBottom">0pt</property><property name="paddingLeft">2pt</property><property name="paddingRight">2pt</property><property name="verticalAlign">middle</property><label id="80"><text-property name="text">Grand total</text-property></label></cell><cell id="83"><property name="paddingTop">0pt</property><property name="paddingBottom">0pt</property><property name="paddingLeft">2pt</property><property name="paddingRight">2pt</property><property name="verticalAlign">middle</property><data id="82"><property name="resultSetColumn">tCount</property></data></cell><cell id="84"><property name="colSpan">2</property><property name="paddingTop">0pt</property><property name="paddingBottom">0pt</property><property name="paddingLeft">2pt</property><property name="paddingRight">2pt</property><property name="verticalAlign">middle</property></cell><cell id="86"><property name="paddingTop">0pt</property><property name="paddingBottom">0pt</property><property name="paddingLeft">2pt</property><property name="paddingRight">2pt</property><property name="verticalAlign">middle</property><property name="textAlign">right</property><data id="85"><structure name="numberFormat"><property name="category">Custom</property><property name="pattern">#,##0.00</property></structure><property name="resultSetColumn">tSum</property></data></cell><cell id="87"><property name="paddingTop">0pt</property><property name="paddingBottom">0pt</property><property name="paddingLeft">2pt</property><property name="paddingRight">2pt</property><property name="verticalAlign">middle</property></cell></row></footer>
