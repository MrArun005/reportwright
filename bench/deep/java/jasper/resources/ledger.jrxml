<?xml version="1.0" encoding="UTF-8"?>
<!-- The ledger report of bench/deep (README.md) as a JasperReports 6 design. @FONTS@ is replaced with the fixtures' font folder. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Ledger" pageWidth="595" pageHeight="842" columnWidth="523" leftMargin="36" rightMargin="36" topMargin="36" bottomMargin="36" whenNoDataType="AllSectionsNoDetail" isIgnorePagination="false">
<style name="r" isDefault="true" fontName="Inter" fontSize="9" pdfFontName="@FONTS@/Inter-Regular.ttf" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
<style name="b" fontName="Inter" fontSize="9" isBold="true" pdfFontName="@FONTS@/Inter-Bold.ttf" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
<field name="id" class="java.lang.Integer"/><field name="account" class="java.lang.String"/><field name="region" class="java.lang.String"/><field name="type" class="java.lang.String"/><field name="date" class="java.lang.String"/><field name="amount" class="java.lang.Double"/><field name="reference" class="java.lang.String"/>
<variable name="gCount" class="java.lang.Integer" resetType="Group" resetGroup="Region" calculation="Count"><variableExpression><![CDATA[$F{id}]]></variableExpression></variable>
<variable name="gSum" class="java.lang.Double" resetType="Group" resetGroup="Region" calculation="Sum"><variableExpression><![CDATA[$F{amount}]]></variableExpression></variable>
<variable name="tCount" class="java.lang.Integer" calculation="Count"><variableExpression><![CDATA[$F{id}]]></variableExpression></variable>
<variable name="tSum" class="java.lang.Double" calculation="Sum"><variableExpression><![CDATA[$F{amount}]]></variableExpression></variable>
<group name="Region" minHeightToStartNewPage="30"><groupExpression><![CDATA[$F{region}]]></groupExpression>
<groupHeader><band height="16"><textField><reportElement x="0" y="0" width="523" height="16" mode="Opaque" backcolor="#DBEAFE" style="b"/><box leftPadding="2" rightPadding="2"/><textElement textAlignment="Left" verticalAlignment="Middle"/><textFieldExpression><![CDATA["Region " + $F{region}]]></textFieldExpression></textField></band></groupHeader>
<groupFooter><band height="14"><textField><reportElement x="0" y="0" width="112" height="14" style="b"/><box leftPadding="2" rightPadding="2"/><textElement textAlignment="Left" verticalAlignment="Middle"/><textFieldExpression><![CDATA["Region total"]]></textFieldExpression></textField><textField><reportElement x="112" y="0" width="50" height="14" style="b"/><box leftPadding="2" rightPadding="2"/><textElement textAlignment="Left" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$V{gCount}]]></textFieldExpression></textField><textField pattern="#,##0.00"><reportElement x="286" y="0" width="70" height="14" style="b"/><box leftPadding="2" rightPadding="2"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$V{gSum}]]></textFieldExpression></textField></band></groupFooter>
</group>
<columnHeader><band height="16"><staticText><reportElement x="0" y="0" width="50" height="16" mode="Opaque" backcolor="#EEF2F7" style="b"/><box leftPadding="2" rightPadding="2"/><textElement textAlignment="Left" verticalAlignment="Middle"/><text><![CDATA[Id]]></text></staticText><staticText><reportElement x="50" y="0" width="62" height="16" mode="Opaque" backcolor="#EEF2F7" style="b"/><box leftPadding="2" rightPadding="2"/><textElement textAlignment="Left" verticalAlignment="Middle"/><text><![CDATA[Account]]></text></staticText><staticText><reportElement x="112" y="0" width="50" height="16" mode="Opaque" backcolor="#EEF2F7" style="b"/><box leftPadding="2" rightPadding="2"/><textElement textAlignment="Left" verticalAlignment="Middle"/><text><![CDATA[Region]]></text></staticText><staticText><reportElement x="162" y="0" width="62" height="16" mode="Opaque" backcolor="#EEF2F7" style="b"/><box leftPadding="2" rightPadding="2"/><textElement textAlignment="Left" verticalAlignment="Middle"/><text><![CDATA[Type]]></text></staticText><staticText><reportElement x="224" y="0" width="62" height="16" mode="Opaque" backcolor="#EEF2F7" style="b"/><box leftPadding="2" rightPadding="2"/><textElement textAlignment="Left" verticalAlignment="Middle"/><text><![CDATA[Date]]></text></staticText><staticText><reportElement x="286" y="0" width="70" height="16" mode="Opaque" backcolor="#EEF2F7" style="b"/><box leftPadding="2" rightPadding="2"/><textElement textAlignment="Right" verticalAlignment="Middle"/><text><![CDATA[Amount]]></text></staticText><staticText><reportElement x="356" y="0" width="167" height="16" mode="Opaque" backcolor="#EEF2F7" style="b"/><box leftPadding="2" rightPadding="2"/><textElement textAlignment="Left" verticalAlignment="Middle"/><text><![CDATA[Reference]]></text></staticText></band></columnHeader>
<detail><band height="14"><textField><reportElement x="0" y="0" width="50" height="14" style="r"/><box leftPadding="2" rightPadding="2"><bottomPen lineWidth="0.5" lineColor="#E5E7EB"/></box><textElement textAlignment="Left" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{id}]]></textFieldExpression></textField><textField><reportElement x="50" y="0" width="62" height="14" style="r"/><box leftPadding="2" rightPadding="2"><bottomPen lineWidth="0.5" lineColor="#E5E7EB"/></box><textElement textAlignment="Left" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{account}]]></textFieldExpression></textField><textField><reportElement x="112" y="0" width="50" height="14" style="r"/><box leftPadding="2" rightPadding="2"><bottomPen lineWidth="0.5" lineColor="#E5E7EB"/></box><textElement textAlignment="Left" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{region}]]></textFieldExpression></textField><textField><reportElement x="162" y="0" width="62" height="14" style="r"/><box leftPadding="2" rightPadding="2"><bottomPen lineWidth="0.5" lineColor="#E5E7EB"/></box><textElement textAlignment="Left" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{type}]]></textFieldExpression></textField><textField><reportElement x="224" y="0" width="62" height="14" style="r"/><box leftPadding="2" rightPadding="2"><bottomPen lineWidth="0.5" lineColor="#E5E7EB"/></box><textElement textAlignment="Left" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{date}]]></textFieldExpression></textField><textField pattern="#,##0.00"><reportElement x="286" y="0" width="70" height="14" style="r"/><box leftPadding="2" rightPadding="2"><bottomPen lineWidth="0.5" lineColor="#E5E7EB"/></box><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression></textField><textField><reportElement x="356" y="0" width="167" height="14" style="r"/><box leftPadding="2" rightPadding="2"><bottomPen lineWidth="0.5" lineColor="#E5E7EB"/></box><textElement textAlignment="Left" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{reference}]]></textFieldExpression></textField></band></detail>
<pageFooter><band height="18"><textField><reportElement x="0" y="0" width="480" height="18" style="r"/><box leftPadding="2" rightPadding="2"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of"]]></textFieldExpression></textField><textField evaluationTime="Report"><reportElement x="480" y="0" width="43" height="18" style="r"/><box leftPadding="2" rightPadding="2"/><textElement textAlignment="Left" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageFooter>
<summary><band height="14"><textField><reportElement x="0" y="0" width="112" height="14" style="b"/><box leftPadding="2" rightPadding="2"/><textElement textAlignment="Left" verticalAlignment="Middle"/><textFieldExpression><![CDATA["Grand total"]]></textFieldExpression></textField><textField><reportElement x="112" y="0" width="50" height="14" style="b"/><box leftPadding="2" rightPadding="2"/><textElement textAlignment="Left" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$V{tCount}]]></textFieldExpression></textField><textField pattern="#,##0.00"><reportElement x="286" y="0" width="70" height="14" style="b"/><box leftPadding="2" rightPadding="2"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$V{tSum}]]></textFieldExpression></textField></band></summary>
</jasperReport>
