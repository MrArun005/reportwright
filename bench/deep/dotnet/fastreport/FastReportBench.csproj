<!-- FastReport Open Source (MIT), a report-generation peer (bench/deep/README.md). A project of its own (System.Drawing
     on libgdiplus, Roslyn for the report's expressions); it shares ../Program.cs, the harness contract.
     dotnet publish -c Release -o out; run: dotnet out/FastReportBench.dll FastReport <job> <size> <outdir> -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Program.cs" />
    <PackageReference Include="FastReport.OpenSource" Version="2026.2.8" />
    <PackageReference Include="FastReport.OpenSource.Export.PdfSimple" Version="2026.2.8" />
    <None Include="ledger.frx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
