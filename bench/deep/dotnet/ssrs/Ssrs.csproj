<!-- SSRS through the Microsoft ReportViewer LocalReport (client-side SSRS, .rdlc), a report-generation peer
     (bench/deep/README.md). ReportViewer 150.x runs on .NET Framework 4.8 only, so this is Windows only (windows-latest).
     Microsoft's licence terms: free to use and redistribute, not open source.
     dotnet build -c Release -o out; run: out/Ssrs.exe ssrs <job> <size> <outdir> -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Ssrs</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ReportingServices.ReportViewerControl.Winforms" Version="150.1652.0" />
    <Reference Include="System.Windows.Forms" /> <!-- ReportDataSource takes a BindingSource overload -->
    <None Include="ledger.rdlc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
