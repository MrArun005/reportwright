 ],
 "DataSets": [
  {
   "Name": "RegionList",
   "Fields": [
    {
     "Name": "name",
     "DataField": "name"
    },
    {
     "Name": "manager",
     "DataField": "manager"
    }
   ],
   "Query": {
    "DataSourceName": "Ledger",
    "CommandText": "jpath=$.regions.*"
   }
  },
  {
   "Name": "Sales",
   "Query": {
    "DataSourceName": "Ledger",
    "CommandText": "jpath=$.sales.*"
   },
   "Fields": [
    {
     "Name": "region",
     "DataField": "region"
    },
    {
     "Name": "month",
     "DataField": "month"
    },
    {
     "Name": "monthNo",
     "DataField": "monthNo"
    },
    {
     "Name": "quarter",
     "DataField": "quarter"
    },
    {
     "Name": "product",
     "DataField": "product"
    },
    {
     "Name": "units",
     "DataField": "units"
    },
    {
     "Name": "amount",
     "DataField": "amount"
    },
    {
     "Name": "avgTicket",
     "Value": "=Fields!amount.Value / Fields!units.Value"
    }
   ],
   "Filters": [
    {
     "FilterExpression": "=Fields!region.Value",
     "Operator": "In",
     "FilterValues": [
      "=Parameters!Regions.Value"
     ]
    },
    {
     "FilterExpression": "=Fields!amount.Value",
     "Operator": "GreaterThanOrEqual",
     "FilterValues": [
      "=Parameters!MinAmount.Value"
     ]
    }
   ]
  }
 ],
 "ReportSections": [
  {
   "Type": "Continuous",
   "Name": "Main",
   "Width": "180mm",
   "Page": {
    "PageWidth": "210mm",
    "PageHeight": "297mm",
    "LeftMargin": "15mm",
    "RightMargin": "15mm",
    "TopMargin": "12mm",
    "BottomMargin": "12mm",
    "PaperOrientation": "Portrait"
   },
   "PageHeader": {
    "Type": "pagesection",
    "Name": "PageHeader",
    "Height": "22mm",
    "Style": {
     "BackgroundColor": "#f3f6fa"
    },
    "ReportItems": [
     {
      "Type": "textbox",
      "Name": "Title",
      "Value": "Regional sales, first half",
      "Left": "3mm",
      "Top": "2mm",
      "Width": "120mm",
      "Height": "10mm",
      "Style": {
       "FontFamily": "Segoe UI",
       "FontSize": "18pt",
       "FontWeight": "Bold",
       "Color": "#1f4e79"
      }
     },
     {
      "Type": "textbox",
      "Name": "Subtitle",
      "Value": "=\"Regions: \" & Join(Parameters!Regions.Value, \", \")",
      "Left": "3mm",
      "Top": "12mm",
      "Width": "120mm",
      "Height": "6mm",
      "Style": {
       "FontSize": "9pt",
       "Color": "DimGray"
      }
     },
     {
      "Type": "textbox",
      "Name": "RunDate",
      "Value": "=Globals!ExecutionTime",
      "Left": "125mm",
      "Top": "12mm",
      "Width": "52mm",
      "Height": "6mm",
      "Style": {
       "FontSize": "8pt",
       "Color": "Gray",
       "TextAlign": "Right",
       "Format": "dd MMM yyyy HH:mm"
      }
     }
    ]
   },
   "PageFooter": {
    "Type": "pagesection",
    "Name": "PageFooter",
    "Height": "8mm",
    "PrintOnFirstPage": true,
    "ReportItems": [
     {
      "Type": "line",
      "Name": "FooterRule",
      "StartPoint": {
       "X": "0mm",
       "Y": "1mm"
      },
      "EndPoint": {
       "X": "180mm",
       "Y": "1mm"
      },
      "LineColor": "Silver",
      "LineWidth": "0.5pt"
     },
     {
      "Type": "textbox",
      "Name": "PageNo",
      "Value": "=\"Page \" & Globals!PageNumber & \" of \" & Globals!TotalPages",
      "Left": "120mm",
      "Top": "2mm",
      "Width": "60mm",
      "Height": "5mm",
      "Style": {
       "FontSize": "8pt",
       "TextAlign": "Right"
      }
     }
    ]
   },
   "Body": {
    "Height": "200mm",
    "ReportItems": [
     {
      "Type": "dvchart",
      "Name": "MonthlyChart",
      "DataSetName": "Sales",
      "Top": "0mm",
      "Width": "180mm",
      "Height": "70mm",
      "Header": {
       "Title": "Sales by month and region"
      },
      "Legend": {
       "Hidden": false
      },
      "PlotArea": {
       "Axes": [
        {
         "AxisType": "X"
        },
        {
         "AxisType": "Y",
         "Format": "n0"
        }
       ]
      },
      "Plots": [
       {
        "PlotName": "Plot1",
        "PlotChartType": "Column",
        "PlotChartSubtype": "Stacked",
        "Encodings": {
         "Values": [
          {
           "Field": {
            "Value": [
             "=Fields!amount.Value"
            ]
           },
           "Aggregate": "Sum"
          }
         ],
         "Category": {
          "Field": {
           "Value": [
            "=Fields!month.Value"
           ]
          },
          "Sort": "Ascending",
          "SortingField": "=Fields!monthNo.Value"
         },
         "Details": [
          {
           "Group": "Stack",
           "Field": {
            "Value": [
             "=Fields!region.Value"
            ]
           }
          }
         ]
        }
       }
      ]
     },
