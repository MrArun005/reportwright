 "ReportParameters": [
  {
   "Name": "Regions",
   "DataType": "String",
   "MultiValue": true,
   "Prompt": "Regions",
   "DefaultValue": {
    "Values": [
     "North",
     "South",
     "East",
     "West"
    ]
   },
   "ValidValues": {
    "DataSetReference": {
     "DataSetName": "RegionList",
     "ValueField": "name",
     "LabelField": "name"
    }
   }
  },
  {
   "Name": "MinAmount",
   "DataType": "Float",
   "Prompt": "Smallest amount to list",
   "DefaultValue": {
    "Values": [
     "0"
    ]
   }
  }
 ],
 "DataSources": [
